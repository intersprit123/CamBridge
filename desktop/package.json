{
  "name": "cambridge-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "CamBridge contributors",
  "description": "CamBridge camera sharing and remote camera control",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis msi"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.cambridge.desktop",
    "productName": "CamBridge",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.cjs", "app/**/*", "node_modules/**/*"],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "msi"],
      "artifactName": "CamBridge-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
